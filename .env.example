# Copy this file to `.env` and fill in real values for local development.
# Never commit a real `.env` file -- it is already excluded in .gitignore.
# In production, set these as actual environment variables / secrets
# (e.g. via your orchestrator's secret store), not as a checked-in file.

# --- PostgreSQL connection (all required except where noted) ---
# DB_HOST and DB_PORT below are only used when running the compiled binary
# natively (see README "Building"). Under `docker compose up`, these two are
# fixed to db/5432 directly in docker-compose.yml and any value set here is
# ignored for that path.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=telemetry_db
DB_USER=telemetry_app
DB_PASSWORD=change-me
DB_SSLMODE=prefer        # optional, defaults to "prefer" (use "require" or "verify-full" in production)
DB_POOL_SIZE=5           # optional, defaults to 5

# --- Application ---
APP_PORT=8080             # optional, defaults to 8080
